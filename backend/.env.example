# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
PORT=4000
DB_PATH=./wallet.db

# Plaid (bank/card aggregator) — sandbox keys from https://dashboard.plaid.com
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
# Optional — set this to a public HTTPS URL (e.g. an ngrok tunnel while
# developing) to get near-real-time nudges via Plaid webhooks instead of
# only on manual sync. Leave unset and manual "sync" still works fine.
PLAID_WEBHOOK_URL=

# PayPal — see the comment at the top of services/paypal.js for the real
# constraints here before assuming this behaves like Plaid
PAYPAL_ENV=sandbox
